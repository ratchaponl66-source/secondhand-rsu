PORT=3000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Set DATABASE_URL to a pooled PostgreSQL connection string in production (for example Neon).
DATABASE_URL=
DB_POOL_MAX=1

# Local development only; SQLite files and local uploads are not persistent on Vercel.
DB_PATH=
UPLOAD_DIR=

# Vercel Blob token for persistent cloud image uploads.
BLOB_READ_WRITE_TOKEN=

# Optional demo seeding; use a dedicated database and explicitly confirm before running.
DEMO_DATABASE_URL=
DEMO_SEED_CONFIRMATION=
DEMO_DB_PATH=
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
